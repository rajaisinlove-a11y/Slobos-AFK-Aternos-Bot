# Pre-filled for lollorabaz.play.hosting (personal deployment).
# These same values are also the built-in defaults in index.js,
# so the bot runs with NO env vars set at all.

MC_HOST=lollorabaz.play.hosting
MC_PORT=25603
MC_USERNAME=SlobosAFK
MC_PASSWORD=
MC_AUTH=offline
# Server is Paper 26.2; ViaBackwards on the server lets a 26.1 client join.
MC_VERSION=26.1

# Render/Railway set PORT automatically; only needed for local runs.
PORT=5000

# Leave empty for a silent bot; use | to separate multiple messages.
CHAT_MESSAGES=
CHAT_INTERVAL_SECONDS=300
ANTI_AFK=true

AUTO_AUTH=false
AUTO_AUTH_PASSWORD=

COMBAT=false

# Required to use /start, /stop and /logs. Generate a long random string,
# then call the endpoints with the header: Authorization: Bearer <token>
DASHBOARD_TOKEN=

# Optional SOCKS5 proxy. Needed when the deployment network's IP range is
# refused by the Minecraft server (e.g. Render/datacenter IPs). Leave
# PROXY_HOST empty to connect directly. See PROXY-SETUP.md.
PROXY_HOST=
PROXY_PORT=1080
PROXY_TYPE=5
PROXY_USERNAME=
PROXY_PASSWORD=
